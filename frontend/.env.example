# API URL for the backend server.
# Leave empty when using Vite dev proxy or Docker Compose (Nginx proxy handles it).
# Set to the full backend URL when deploying frontend separately (e.g., on Vercel/Netlify).
# Example: VITE_API_URL=https://lihqet-api.railway.app
VITE_API_URL=
